escobar.club, www.escobar.club {
	# CSP's script-src intentionally excludes 'unsafe-inline' - the one inline <script> in
	# index.html (dark-mode flash prevention) is allowlisted by exact content hash instead.
	# If that script's content ever changes, recompute the hash (see frontend/index.html)
	# or it will silently stop running (theme just won't apply until the SPA hydrates).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Zttl3k7iuiAu2nsw3wmQOMhbFYe1tMXqMvO/fMU2pBU=' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
	reverse_proxy frontend:80
}
