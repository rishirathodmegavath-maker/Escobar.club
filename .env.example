# Copy this file to .env and fill in real values before running docker-compose.
# Never commit the real .env file.

# --- Database ---
DB_NAME=escobar_club
DB_USERNAME=escobar
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# --- Auth / JWT ---
# Must be a long, random string (32+ bytes) in any real environment.
JWT_SECRET=change-this-to-a-long-random-string-before-deploying
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Apify (Instagram post metrics scraper) ---
# Unofficial scraper, not Meta's Graph API - same ToS caveat applies. Get a token from
# https://console.apify.com/account/integrations
APIFY_API_TOKEN=change-me
APIFY_ACTOR_ID=apify~instagram-scraper
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_TIMEOUT_MS=120000
METRICS_SYNC_MIN_INTERVAL_MINUTES=15

# --- Google OAuth ---
# Create an OAuth 2.0 Client ID (Web application) at https://console.cloud.google.com/apis/credentials
# Add http://localhost:5173 to "Authorized JavaScript origins". Same value goes in both vars below -
# Spring reads GOOGLE_CLIENT_ID, Vite only exposes browser env vars prefixed with VITE_.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Password reset ---
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password

# --- Login security ---
# Failed-attempt lockout, and TOTP (authenticator app) two-factor login.
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
TWO_FACTOR_ISSUER=Escobar Club
# Passphrase used to encrypt stored TOTP secrets at rest. Must be long and random in any real environment.
TWO_FACTOR_SECRET_KEY=change-this-two-factor-encryption-key-in-every-environment
# Passwordless email OTP login.
OTP_LOGIN_CODE_TTL_MINUTES=10
OTP_LOGIN_MAX_ATTEMPTS=5
OTP_LOGIN_RESEND_INTERVAL_SECONDS=60

# --- Email delivery (password reset + email verification) ---
# "logging" writes links to the backend console instead of sending real email - no setup needed.
# "resend" sends real email via https://resend.com - create a free account and an API key at
# https://resend.com/api-keys. Until you verify your own sending domain there, Resend only lets
# the sandbox sender (onboarding@resend.dev) deliver to the email address on your Resend account.
# "zeptomail" sends real email via https://www.zoho.com/zeptomail - requires a Mail Agent API key
# (SMTP/API tab) and a domain verified there (DKIM/bounce DNS records).
EMAIL_PROVIDER=logging
EMAIL_FROM=Escobar Club <onboarding@resend.dev>
RESEND_API_KEY=
ZEPTOMAIL_API_KEY=

# --- Email verification ---
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=48
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:5173/verify-email

# --- Frontend (local dev only, used by Vite) ---
VITE_API_PROXY_TARGET=http://localhost:8080
